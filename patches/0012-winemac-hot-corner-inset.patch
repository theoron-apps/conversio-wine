-                }
-            }
-        }
-
-        if (clipping)
-            ret = [controller startClippingCursor:rect];
-        else
-            ret = [controller stopClippingCursor];
+        ret = [[WineApplicationController sharedController] applyCursorClipRect:r];
     });
 
