Conversio: detach a captured hidden cursor from the mouse in fullscreen games.

GTA V Enhanced hides the cursor and clips it to the whole screen. With the
default confinement clipping the invisible cursor still travels to the screen
corners (seen at 1728,1117), so macOS hot corners (Notification Center, Quick
Note, ...) fire. Patch 0009 only hid the Dock/menu bar.

While the app is active, the client wants the cursor hidden, the cursor is
clipped by the confinement handler and the front window is fullscreen, call
CGAssociateMouseAndMouseCursorPosition(false) like SDL's relative mode and send
only relative motion. Re-associate when the cursor is shown, clipping stops,
the window leaves fullscreen or the app deactivates. SetCursorPos warps keep
the detached state. The event-tap clipping handler is left as is.

diff --git a/dlls/winemac.drv/cocoa_app.h b/dlls/winemac.drv/cocoa_app.h
--- a/dlls/winemac.drv/cocoa_app.h
+++ b/dlls/winemac.drv/cocoa_app.h
@@ -64,6 +64,7 @@
     WineWindow* lastTargetWindow;
     WineWindow* mouseCaptureWindow;
     BOOL forceNextMouseMoveAbsolute;
+    BOOL cursorDetached;
     double mouseMoveDeltaX, mouseMoveDeltaY;
     NSUInteger unmatchedMouseDowns;
 
diff --git a/dlls/winemac.drv/cocoa_app.m b/dlls/winemac.drv/cocoa_app.m
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -1071,6 +1071,21 @@
         if (options != [NSApp presentationOptions])
             [NSApp setPresentationOptions:options];
 
+        /* A captured, hidden cursor in a fullscreen game still moves to the
+         * screen corners inside the confinement rect, and macOS hot corners
+         * react to that position. While the game owns the mouse, detach the
+         * cursor from the mouse (as SDL's relative mode does) and deliver
+         * deltas only. Restore it when the cursor is shown, clipping ends or
+         * the app deactivates. */
+        BOOL detach = [NSApp isActive] && clientWantsCursorHidden && self.clippingCursor &&
+                      [clipCursorHandler isKindOfClass:[WineConfinementClipCursorHandler class]] &&
+                      [[self frontWineWindow] isFullscreen];
+        if (detach != cursorDetached)
+        {
+            cursorDetached = detach;
+            CGAssociateMouseAndMouseCursorPosition(!detach);
+            forceNextMouseMoveAbsolute = TRUE;
+        }
     }
 
     - (void) updateCursor:(BOOL)force
@@ -1314,7 +1329,7 @@
             {
                 lastSetCursorPositionTime = [[NSProcessInfo processInfo] systemUptime];
 
-                CGAssociateMouseAndMouseCursorPosition(true);
+                CGAssociateMouseAndMouseCursorPosition(!cursorDetached);
             }
         }
 
@@ -1365,6 +1380,7 @@
         [self setCursorPosition:NSPointToCGPoint([self flippedMouseLocation:[NSEvent mouseLocation]])];
 
         [self updateWindowsForCursorClipping];
+        [self updateCursorPresentation];
 
         return TRUE;
     }
