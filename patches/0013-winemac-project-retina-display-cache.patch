+/* Called only with freshly read shared state. Never publish the adjusted
+ * rectangles to either the registry or the winstation monitor table.
+ */
+static void project_display_cache(void)
+{
+    struct source *source;
+    struct monitor *monitor;
+    LONG desktop_scale = 0;
+
+    if (emulate_modeset || is_virtual_desktop()) return;
+    LIST_FOR_EACH_ENTRY( source, &sources, struct source, entry )
+    {
+        struct gdi_display_mode_view view;
+        if (!source->driver_name[0] || !user_driver->pGetDisplayModeView( source->driver_name, &view )) continue;
+        free( source->modes );
+        source->modes = view.modes;
+        view.modes = NULL;
+        source->view = view;
+        source->mode_count = view.mode_count;
+        qsort( source->modes, source->mode_count, sizeof(*source->modes), mode_compare );
+        map_source_mode( source, &source->current, TRUE );
+        map_source_mode( source, &source->physical, TRUE );
+        if (source->state_flags & DISPLAY_DEVICE_PRIMARY_DEVICE) desktop_scale = view.scale;
+        TRACE( "projected source %u (%s) to %s\n", source->id,
+               debugstr_a( source->driver_name ), debugstr_devmodew( &source->current ) );
+    }
+
+    LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
+    {
+        int scale = monitor->source ? monitor->source->view.scale : 0;
+        monitor->rc_work.left = scale_display_coord( monitor->rc_work.left, scale );
+        monitor->rc_work.top = scale_display_coord( monitor->rc_work.top, scale );
+        monitor->rc_work.right = scale_display_coord( monitor->rc_work.right, scale );
+        monitor->rc_work.bottom = scale_display_coord( monitor->rc_work.bottom, scale );
+    }
+    InterlockedExchange( &retina_desktop_scale, desktop_scale );
+}
