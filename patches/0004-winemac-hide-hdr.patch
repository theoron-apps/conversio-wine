Conversio: games see SDR screens unless HDR is turned on.

On XDR displays D3DMetal reports HDR to DXGI (it reads NSScreen's extended dynamic range
values), and games such as Euro Truck Simulator 2 pick an HDR10 (BT.2100 PQ) swap chain
and stay black. Windows keeps HDR off until the user enables it, so the Mac driver now
makes every screen look SDR to the process: NSScreen's EDR maxima read as 1.0. Wine's own
monitor info (hdr_enabled, DISPLAYCONFIG advanced color) follows. "EnableHDR"="y" in the
Mac Driver key (or AppDefaults\<app>.exe\Mac Driver) keeps the real values.

diff --git a/dlls/winemac.drv/cocoa_display.m b/dlls/winemac.drv/cocoa_display.m
index a96c27f..6f845c5 100644
--- a/dlls/winemac.drv/cocoa_display.m
+++ b/dlls/winemac.drv/cocoa_display.m
@@ -26,6 +26,7 @@
 #import <Metal/Metal.h>
 #endif
 #include <dlfcn.h>
+#import <objc/runtime.h>
 #include "macdrv_cocoa.h"
 
 #pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
@@ -1040,6 +1041,40 @@ int macdrv_get_monitors(CGDirectDisplayID adapter_id, struct macdrv_monitor** ne
  *
  * Frees an monitor list allocated from macdrv_get_monitors()
  */
+/***********************************************************************
+ *              macdrv_hide_hdr
+ *
+ * Conversio: make every screen look SDR to this process.
+ *
+ * D3DMetal reports HDR to DXGI from NSScreen's extended dynamic range values, and games such
+ * as Euro Truck Simulator 2 then pick an HDR10 (BT.2100 PQ) swap chain on XDR displays and
+ * show a black screen. Windows keeps HDR off unless the user turns it on, so do the same:
+ * the EDR maxima read as 1.0 (no headroom). This covers the monitor info Wine itself
+ * reports too (hdr_enabled in macdrv_get_monitors, DISPLAYCONFIG advanced color).
+ */
+static CGFloat sdr_edr_component_value(id self, SEL _cmd)
+{
+    return 1.0;
+}
+
+void macdrv_hide_hdr(void)
+{
+    static const char * const selectors[] = {
+        "maximumPotentialExtendedDynamicRangeColorComponentValue",
+        "maximumExtendedDynamicRangeColorComponentValue",
+        "maximumReferenceExtendedDynamicRangeColorComponentValue",
+    };
+    Class cls = objc_getClass("NSScreen");
+    unsigned int i;
+
+    for (i = 0; cls && i < sizeof(selectors) / sizeof(selectors[0]); i++)
+    {
+        Method method = class_getInstanceMethod(cls, sel_registerName(selectors[i]));
+        if (method)
+            method_setImplementation(method, (IMP)sdr_edr_component_value);
+    }
+}
+
 void macdrv_free_monitors(struct macdrv_monitor* monitors, int monitor_count)
 {
     while (monitor_count--)
