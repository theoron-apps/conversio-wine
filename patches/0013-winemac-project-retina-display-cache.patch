+/* Keep mode writes reversible in the shared registry. Non-original modes
+ * already use native dimensions, and a detached source must stay detached.
+ */
+static LONG scale_display_coord( LONG pos, int scale )
+{
+    if (scale > 0) return min( (INT64)INT_MAX, max( (INT64)INT_MIN, (INT64)pos * 2 ) );
+    return scale < 0 ? pos / 2 : pos;
+}
+
+/* The macOS driver scales around the main display's origin. Wine's shared
+ * cursor and input messages continue to use the bottle's raw coordinates. */
+RECT map_retina_desktop_rect( RECT rect, BOOL from_server )
+{
+    LONG scale = ReadNoFence( &retina_desktop_scale );
+    if (!scale) return rect;
+    if (!from_server) scale = -scale;
+    SetRect( &rect, scale_display_coord( rect.left, scale ), scale_display_coord( rect.top, scale ),
+             scale_display_coord( rect.right, scale ), scale_display_coord( rect.bottom, scale ) );
+    return rect;
+}
+
+static void map_source_mode( const struct source *source, DEVMODEW *mode, BOOL to_local )
+{
+    const DEVMODEW *from = to_local ? &source->view.shared_original : &source->view.local_original;
+    const DEVMODEW *to = to_local ? &source->view.local_original : &source->view.shared_original;
+    int scale = to_local ? source->view.scale : -source->view.scale;
+
+    if (!source->view.mode_count) return;
+
+    if ((mode->dmFields & (DM_PELSWIDTH | DM_PELSHEIGHT)) == (DM_PELSWIDTH | DM_PELSHEIGHT)
+        && mode->dmPelsWidth == from->dmPelsWidth && mode->dmPelsHeight == from->dmPelsHeight
+        && (!(mode->dmFields & DM_DISPLAYFREQUENCY) || mode->dmDisplayFrequency == from->dmDisplayFrequency)
+        && (!(mode->dmFields & DM_DISPLAYORIENTATION) || mode->dmDisplayOrientation == from->dmDisplayOrientation)
+        && (!(mode->dmFields & DM_DISPLAYFIXEDOUTPUT) || mode->dmDisplayFixedOutput == from->dmDisplayFixedOutput)
+        && (!(mode->dmFields & DM_DISPLAYFLAGS) || !((mode->dmDisplayFlags ^ from->dmDisplayFlags) & DM_INTERLACED)))
+    {
+        mode->dmPelsWidth = to->dmPelsWidth;
+        mode->dmPelsHeight = to->dmPelsHeight;
+    }
+
+    if (mode->dmFields & DM_POSITION)
+    {
+        mode->dmPosition.x = scale_display_coord( mode->dmPosition.x, scale );
+        mode->dmPosition.y = scale_display_coord( mode->dmPosition.y, scale );
+    }
+}
